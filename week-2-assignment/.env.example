OPENAI_API_KEY=
# Model used when a request does not specify one.
DEFAULT_MODEL=gpt-4o-mini

# --- Embeddings (week-2-assignment) ---
# Native size is 1536 for text-embedding-3-small, 3072 for -3-large. The
# `dimensions` parameter can truncate below native but never above it.
EMBEDDING_MODEL=text-embedding-3-small
# Must equal the Pinecone index's dimension below, or every upsert is rejected.
EMBEDDING_DIMENSIONS=1536

# --- Chunking (week-2-assignment) ---
# Counted in CHARACTERS, not tokens. The overlap carries the tail of one chunk
# into the next so a sentence split across a boundary stays retrievable, and it
# must be SMALLER than the chunk size or the splitter refuses to build.
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# --- Vector store: Pinecone (week-2-assignment) ---
# The only one the SDK reads by itself — Pinecone() with no arguments finds it.
PINECONE_API_KEY=
# The remaining three are ours to read; the SDK does not look them up.
PINECONE_INDEX_NAME=ask-api-docs
# Cloud and region are used only when creating the index, not when querying it.
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
