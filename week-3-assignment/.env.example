# Model -- set ONE of these. OpenRouter is preferred: Google AI Studio's free tier allows only
# 20 requests a day per model, and one agent run spends several.
OPENROUTER_API_KEY=your_openrouter_api_key_here
# GOOGLE_API_KEY=your_google_api_key_here      # https://aistudio.google.com/apikey
# GEMINI_MODEL=gemini-3.6-flash
# USE_OPENROUTER=0                              # force the Google key even if OpenRouter is set

# Supabase (all agents and demos 2-3)
# A personal access token reaches every project on the account -- treat it like a password.
# Generate one at: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=your_personal_access_token_here
SUPABASE_PROJECT_REF=your_project_ref_here

# Password for the Streamlit app. Optional locally; required on Render, where the app stays
# locked without it.
APP_PASSWORD=

# Langfuse tracing (optional -- the app runs without it)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
